mapscripts BersketCity_MapScripts {


// VAR_BERSKET_CITY_STATE
// 1: defeated rival outside the lab
// 2: spoken to the Professors, given the Engram, given mission
// 3: obtained the first badge: learned Cut
// 4: spoken to the professors again (optional)
// 5: entered Petalburg Woods
// 6: witnessed a Team Aqua grunt get abducted by the Rot
// 7: defeated a kid looking for his brother
// 8: encountered the mad ranger in the Grove
// 9: defeated the scripted Rot double battle
// 10: defeated Arceus/Vamporin
// 11: gave fruit to Guljira (Professors are also there), talked to him, asked to investigate the food storage (to find what the Gulpin were seeking)
// 12: obtained the first Sacred Ingredient
// 13: spoken to Guljira, sent on quest for Ambrosia (tunnel is now open)

// At >= 10, the player can ask the Professors about 


MAP_SCRIPT_ON_TRANSITION {
    setflag(FLAG_VISITED_BERSKET_CITY)
    setflag(FLAG_HIDE_RIVAL_BERSKETCITY)
    setvar(VAR_BERSKET_CITY_STATE, 1)
    setflag(FLAG_BADGE01_GET)
}

}
    
script BersketCity_EventScript_Guljira {

    // if Guljira is still hungry
    if (var(VAR_BERSKET_CITY_STATE) < 11) {
        playmoncry (SPECIES_GULPIN, 0)
        msgbox(format("GUUUULLLLLP\pHey, I'm hungry. Do you have any food?"))

        // haven't talken to profs yet
        if (var(VAR_BERSKET_CITY_STATE) < 2) {
            msgbox("Lips: Oh no!\nWhat's happened?")
            msgbox("No food.\nGulp.")
            msgbox(format("Lips: Something must have gone wrong. This is bad.\p{PLAYER}, this is Guljira. He's our leader.\pBut he's supposed to have special food from the forest. Without it, the hunger is too much, and his great wisdom is gone.\pWe need to talk to the professors."))
            closemessage
            end
        }
        // haven't learned Cut yet
        elif (var(VAR_BERSKET_CITY_STATE) < 3) {
            msgbox(format("Lips: Don't worry! We're going to get you food. We just need to go to Rustboro first. We'll be quick."))
            closemessage
            end
        }
    }

    // later dialogue
}

script BersketCity_EventScript_Rival {
    lockall
    opendoor (40, 31)
    delay (10)
    applymovement (LOCALID_PLAYER, BersketCity_Movement_StepAway)
    waitmovement (LOCALID_PLAYER)
    delay (20)

    checkplayergender
	if (var(VAR_RESULT) == MALE) {
        playbgm(MUS_ENCOUNTER_MAY, TRUE)
    } else {
        playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    }

    addobject(LOCALID_BERSKET_CITY_GULPINATOR)
    delay(10)
    applymovement(LOCALID_BERSKET_CITY_GULPINATOR, Common_Movement_ExclamationMark)
    playse(SE_PIN)
    waitmovement
    applymovement(LOCALID_BERSKET_CITY_GULPINATOR, BersketCity_Movement_GulpinatorEntrance)
    delay(20)
    addobject(LOCALID_BERSKET_CITY_RIVAL)
    call(Common_EventScript_SetupRivalGfxId)
    applymovement(LOCALID_BERSKET_CITY_RIVAL, BersketCity_Movement_RivalEntrance)
    waitmovement(LOCALID_BERSKET_CITY_GULPINATOR)
    waitmovement(LOCALID_BERSKET_CITY_RIVAL)
    msgbox(format("{RIVAL}: {PLAYER}! You're finally here. Just in time."))
    msgbox(format("Gulpinator: Behold my true form!"))

    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        switch (var(VAR_STARTER_MON)){
            case 0:
                trainerbattle_no_intro (TRAINER_MAY_TREECKO, BersketCity_Text_MayDefeat)
                clearflag(TRAINER_MAY_TREECKO)
                break
            case 1:
                trainerbattle_no_intro (TRAINER_MAY_TORCHIC, BersketCity_Text_MayDefeat)
                clearflag(TRAINER_MAY_TORCHIC)
                break
            case 2:
                trainerbattle_no_intro (TRAINER_MAY_MUDKIP, BersketCity_Text_MayDefeat)
                clearflag(TRAINER_MAY_MUDKIP)
                break
        }
    }
    else {
        switch (var(VAR_STARTER_MON)){
            case 0:
                trainerbattle_no_intro (TRAINER_BRENDAN_TREECKO, BersketCity_Text_BrendanDefeat)
                clearflag(TRAINER_BRENDAN_TREECKO) // for later battle
                break
            case 1:
                trainerbattle_no_intro (TRAINER_BRENDAN_TORCHIC, BersketCity_Text_BrendanDefeat)
                clearflag(TRAINER_BRENDAN_TORCHIC)
                break
            case 2:
                trainerbattle_no_intro (TRAINER_BRENDAN_MUDKIP, BersketCity_Text_BrendanDefeat) 
                clearflag(TRAINER_BRENDAN_MUDKIP)
                break  
        }
    }
    call (BersketCity_EventScript_RivalDefeated)
}

script BersketCity_EventScript_RivalDefeated {
    msgbox(format("{RIVAL}: Looks like my dad was right to give you that Pokémon. Seeing you, I get the feeling you could befriend any Pokémon with ease."))
    msgbox(format("Gulpinator: And you have a Gulpin friend! Nice!"))
    msgbox(format("Lips: Hi.\n So you must've eaten the Steel berry.\p Wow.\p That's kind of gross."))
    msgbox(format("Gulpinator: Better than the Normal berry!"))
    msgbox(format("Lips: So why'd you lose then?"))
    msgbox(format("{RIVAL}: Alright, we've gotta go. We're heading to Rustboro to learn this 'Engram' thing.\p Maybe the Professors will give you a copy too.\p And we're off!"))
    msgbox(format("Gulpinator: Taste ya later!"))
    closemessage
    applymovement(LOCALID_BERSKET_CITY_GULPINATOR, BersketCity_Movement_GulpinatorExit)
    delay(3)
    applymovement(LOCALID_BERSKET_CITY_RIVAL, BersketCity_Movement_RivalExit)
    waitmovement(LOCALID_BERSKET_CITY_GULPINATOR)
    waitmovement(LOCALID_BERSKET_CITY_RIVAL)
    removeobject(LOCALID_BERSKET_CITY_GULPINATOR)
    removeobject(LOCALID_BERSKET_CITY_RIVAL)
    setflag(FLAG_HIDE_RIVAL_BERSKETCITY)
    setvar(VAR_BERSKET_CITY_STATE, 1)
    fadedefaultbgm
    releaseall
    end
}

movement BersketCity_Movement_StepAway {
    face_up
    lock_facing_direction
	walk_down
	unlock_facing_direction
    face_up
}

movement BersketCity_Movement_GulpinatorEntrance {
    walk_down
	walk_right
	face_down
}

movement BersketCity_Movement_RivalEntrance {
    walk_down
}

movement BersketCity_Movement_GulpinatorExit {
    walk_fast_down * 2
    walk_fast_left * 10
}

movement BersketCity_Movement_RivalExit {
    walk_right
    walk_down
    walk_fast_down
    walk_fast_left * 10
}

text BersketCity_Text_BrendanDefeat{
    "Wow! That's great!\n"
	"{PLAYER}, you're pretty good!"
}

text BersketCity_Text_MayDefeat{
    "Wow! That's great!\n"
	"{PLAYER}, you're pretty good!"
}


